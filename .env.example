# Groundwork runs with none of these set. Each one switches on a capability that
# the app otherwise reports honestly as "not connected" rather than faking.

# Public base URL. Used to build the customer-facing links that go out in
# quotes, invoices and review requests.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments ---------------------------------------------------------------
# Without a key the pay-now button is hidden and the owner records payments by
# hand. With a test key, real Stripe Checkout runs in test mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Message drafting -------------------------------------------------------
# Optional. Warms up a draft the owner then edits. Every message has a template
# fallback, so nothing breaks without it.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Field conditions -------------------------------------------------------
# Optional. Turns on the weather panel and rain warnings for scheduled outdoor
# work. Until it is set the panel says so rather than inventing a forecast.
# OPENWEATHER_API_KEY=

# --- Map view ---------------------------------------------------------------
# Optional. Plots today's stops. Routes are listed either way.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Scheduled automation sweep ---------------------------------------------
# Optional. Protects /api/cron/automations when the deployment is public.
# CRON_SECRET=

# --- Storage ----------------------------------------------------------------
# Where the SQLite database lives. Defaults to ./.data/groundwork.db
# GROUNDWORK_DATA_DIR=
# GROUNDWORK_DB_PATH=
